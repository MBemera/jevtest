{
  "name": "15-layout-sizes",
  "title": "Layout at 1024, 800 and 640 pixels wide: panel behaviour, every tab, audits and screenshots",
  "features": ["small-screen", "panel-toggle", "layout-audit"],
  "app": {"seed": "sample", "screen": "1366x768"},
  "steps": [
    {"do": "resize_window", "width": 1024, "height": 700},
    {"do": "select_item", "item": "Riley Ready"},
    {"do": "select_tab", "tab": "1 Prepare"},
    {"do": "audit", "kind": "layout"},
    {"do": "select_tab", "tab": "2 Assess"},
    {"do": "audit", "kind": "layout"},
    {"do": "screenshot", "note": "1024 assess"},
    {"do": "select_tab", "tab": "3 Evidence"},
    {"do": "select_tab", "tab": "4 Finalise"},
    {"do": "audit", "kind": "layout"},
    {"do": "select_tab", "tab": "5 Findings review"},
    {"do": "resize_window", "width": 800, "height": 600, "expect": {"contains": "Show panel"}},
    {"do": "click", "target": "Show panel", "expect": {"contains": "Hide panel"}},
    {"do": "select_item", "item": "Sam Synthetic", "expect": {"contains": "Show panel"}},
    {"do": "select_tab", "tab": "1 Prepare"},
    {"do": "audit", "kind": "layout"},
    {"do": "screenshot", "note": "800 prepare"},
    {"do": "select_tab", "tab": "2 Assess"},
    {"do": "audit", "kind": "layout"},
    {"do": "resize_window", "width": 640, "height": 480},
    {"do": "select_tab", "tab": "4 Finalise"},
    {"do": "audit", "kind": "layout"},
    {"do": "screenshot", "note": "640 finalise"},
    {"do": "select_tab", "tab": "3 Evidence"},
    {"do": "audit", "kind": "layout"},
    {"do": "press_key", "keys": "F1"},
    {"do": "screenshot", "note": "640 help"},
    {"do": "close_window"}
  ]
}
