{
  "name": "01-first-run",
  "title": "First run: every way the unlock dialog refuses, then create and reopen a vault",
  "features": ["unlock-dialog", "vault-create", "file-chooser", "lock", "unlock"],
  "app": {"seed": "none"},
  "steps": [
    {"do": "expect", "contains": "DT | Open local records"},
    {"do": "click", "target": "Open", "role": "button", "expect": {"dialog": "Could not open records", "message": "Choose a local folder"}},
    {"do": "click", "target": "OK"},
    {"do": "type_text", "target": "Choose a device folder", "text": "fixtures"},
    {"do": "type_text", "target": "Vault passphrase", "text": "correct-horse-battery-staple"},
    {"do": "set_checked", "target": "Create a new vault", "checked": true},
    {"do": "click", "target": "Open", "role": "button", "expect": {"message": "Choose an empty folder"}},
    {"do": "click", "target": "OK"},
    {"do": "click", "target": "Choose folder", "expect": {"dialog": "file chooser"}},
    {"do": "type_text", "target": "Path", "text": "first-vault", "submit": "enter", "expect": {"modal": "Open local records"}},
    {"do": "type_text", "target": "Vault passphrase", "text": "short"},
    {"do": "click", "target": "Open", "role": "button", "expect": {"message": "at least 12 characters"}},
    {"do": "click", "target": "OK"},
    {"do": "type_text", "target": "Vault passphrase", "text": "eleven-char"},
    {"do": "click", "target": "Open", "role": "button", "expect": {"message": "at least 12 characters"}},
    {"do": "click", "target": "OK"},
    {"do": "type_text", "target": "Vault passphrase", "text": "twelve-chars"},
    {"do": "click", "target": "Open", "role": "button", "expect": {"contains": "New assessment", "modal": false}},
    {"do": "click", "target": "Lock records", "expect": {"contains": "Unlock records"}},
    {"do": "click", "target": "Unlock records", "expect": {"dialog": "Open local records"}},
    {"do": "type_text", "target": "Vault passphrase", "text": "wrong-passphrase-123"},
    {"do": "click", "target": "Open", "role": "button", "expect": {"message": "wrong passphrase"}},
    {"do": "click", "target": "OK"},
    {"do": "type_text", "target": "Vault passphrase", "text": "twelve-chars"},
    {"do": "click", "target": "Open", "role": "button", "expect": {"contains": "New assessment", "modal": false}},
    {"do": "audit", "kind": "all"}
  ]
}
