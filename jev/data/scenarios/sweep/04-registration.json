{
  "name": "04-registration",
  "title": "Registration checks: manual record, NHVR setup, approval, mocked answers and bad plates",
  "features": ["registration-manual", "registration-setup", "registration-nhvr", "network-approval"],
  "app": {"seed": "sample", "network": "mock"},
  "steps": [
    {"do": "select_item", "item": "Sam Synthetic"},
    {"do": "click", "target": "Record a registration check myself", "expect": {"dialog": "Record a registration check"}},
    {"do": "select_option", "target": "Status you were shown", "option": "Registered"},
    {"do": "type_text", "target": "Expiry", "text": "2027-06-30"},
    {"do": "click", "target": "Save", "window": "Record a registration check",
     "expect": {"contains": "entered by the assessor", "network": "none"}},
    {"do": "click", "target": "Check registration with NHVR", "expect": {"dialog": "Registration check setup"}},
    {"do": "click", "target": "Cancel", "expect": {"message": "Add an NHVR subscription key"}},
    {"do": "click", "target": "OK"},
    {"do": "click", "target": "Registration check setup (optional)", "expect": {"dialog": "Registration check setup"}},
    {"do": "type_text", "target": "NHVR subscription key", "text": "jev-synthetic-key-123"},
    {"do": "click", "target": "Save", "expect": {"status": "No request sent", "network": "none"}},
    {"do": "click", "target": "Check registration with NHVR", "expect": {"dialog": "Approve registration check", "network": "none"}},
    {"do": "click", "target": "Cancel", "expect": {"network": "none"}},
    {"do": "click", "target": "Check registration with NHVR"},
    {"do": "click", "target": "Send this plate", "expect": {"network": "api-public.nhvr.gov.au"}},
    {"do": "wait", "seconds": 5, "until": "idle"},
    {"do": "expect", "contains": "Reported by NHVR Portal API"},
    {"do": "network_log", "count": 1},
    {"do": "set_network_mock", "scenario": "not_found", "service": "nhvr"},
    {"do": "click", "target": "Check registration with NHVR"},
    {"do": "click", "target": "Send this plate", "expect": {"status": "no heavy vehicle registration"}},
    {"do": "set_network_mock", "scenario": "different_plate", "service": "nhvr"},
    {"do": "click", "target": "Check registration with NHVR"},
    {"do": "click", "target": "Send this plate", "expect": {"status": "different plate"}},
    {"do": "set_network_mock", "scenario": "http_401", "service": "nhvr"},
    {"do": "click", "target": "Check registration with NHVR"},
    {"do": "click", "target": "Send this plate", "expect": {"status": "HTTP 401"}},
    {"do": "type_text", "target": "Registration", "text": "!!bad plate!!", "submit": "tab"},
    {"do": "click", "target": "Check registration with NHVR", "expect": {"message": "registration plate"}},
    {"do": "click", "target": "OK"}
  ]
}
