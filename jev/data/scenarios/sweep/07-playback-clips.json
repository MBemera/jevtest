{
  "name": "07-playback-clips",
  "title": "Playback dock: watch, clip moments, adjust, timestamp an observation, save clips, review",
  "features": ["playback", "clip-moment", "clip-adjust", "clip-save", "video-moment-observation", "review-from-dock"],
  "app": {"seed": "sample"},
  "steps": [
    {"do": "select_item", "item": "Riley Ready"},
    {"do": "select_tab", "tab": "3 Evidence"},
    {"do": "click", "target": "Import original evidence"},
    {"do": "type_text", "target": "Path", "text": "dashcam-45s-1280x720.mp4", "submit": "enter"},
    {"do": "wait", "seconds": 30, "until": "idle"},
    {"do": "select_item", "item": "original", "tab_hint": "3 Evidence"},
    {"do": "click", "target": "Check video file", "wait_busy": 60, "expect": {"status": "Media validated"}},
    {"do": "select_item", "item": "original", "tab_hint": "3 Evidence"},
    {"do": "click", "target": "Watch video and mark assessment", "expect": {"contains": "Watch and assess"}},
    {"do": "wait", "seconds": 3},
    {"do": "click", "target": "Clip this moment", "expect": {"contains": "Save clips to evidence"}},
    {"do": "click", "target": "Start -5s"},
    {"do": "click", "target": "End +5s"},
    {"do": "wait", "seconds": 2},
    {"do": "click", "target": "Clip this moment"},
    {"do": "click", "target": "Remove"},
    {"do": "click", "target": "Clip this moment"},
    {"do": "click", "target": "Pause"},
    {"do": "click", "target": "Use this moment in observation", "expect": {"contains": "[Video "}},
    {"do": "click", "target": "Save clips to evidence", "wait_busy": 60, "expect": {"status": "Clip"}},
    {"do": "wait", "seconds": 30, "until": "idle"},
    {"do": "click", "target": "Mark this video as reviewed", "expect": {"dialog": "Confirm trainer review"}},
    {"do": "click", "target": "Yes"},
    {"do": "select_tab", "tab": "3 Evidence", "expect": {"contains": "clip"}},
    {"do": "click", "target": "Close video"},
    {"do": "screenshot", "note": "after clipping"}
  ]
}
