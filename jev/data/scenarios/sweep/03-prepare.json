{
  "name": "03-prepare",
  "title": "Prepare: every field, dropdown, parameter and directory save, then reuse from the directory",
  "features": ["new-assessment", "prepare-fields", "licence-class", "vehicle-catalogue", "jurisdiction",
               "prerequisites", "prepare-parameters", "save-preparation", "directory-save", "new-from-directory"],
  "app": {"seed": "empty"},
  "steps": [
    {"do": "click", "target": "New assessment", "expect": {"status": "Saved locally"}},
    {"do": "click", "target": "Save driver to directory", "expect": {"message": "assessor name"}},
    {"do": "click", "target": "OK"},
    {"do": "type_text", "target": "Organisation", "text": "synthetic haulage pty ltd", "submit": "tab"},
    {"do": "type_text", "target": "Assessor", "text": "alex assessor", "submit": "tab"},
    {"do": "type_text", "target": "Driver name", "text": "jordan example", "submit": "tab"},
    {"do": "type_text", "target": "Internal driver ID", "text": "d-0001", "submit": "tab",
     "expect": {"contains": "textbox \"Internal driver ID\" = \"d-0001\""}},
    {"do": "select_option", "target": "Licence class", "option": "HC - Heavy Combination"},
    {"do": "type_text", "target": "Licence expiry / verification reference", "text": "2028-01-31 / VER-1", "submit": "tab"},
    {"do": "type_text", "target": "Fleet ID", "text": "FLEET-42", "submit": "tab"},
    {"do": "type_text", "target": "Registration", "text": "XY12ZA", "submit": "tab"},
    {"do": "type_text", "target": "Vehicle and trailer configuration", "text": "prime mover and semitrailer", "submit": "tab"},
    {"do": "type_text", "target": "Assessed scope", "text": "linehaul freight", "submit": "tab"},
    {"do": "type_text", "target": "Route, weather and traffic", "text": "dry, moderate traffic", "submit": "tab"},
    {"do": "type_text", "target": "Recording policy / notice reference", "text": "POLICY-7", "submit": "tab"},
    {"do": "select_option", "target": "Primary operating jurisdiction", "option": "NSW"},
    {"do": "select_option", "target": "Truck make", "option": "KENWORTH"},
    {"do": "select_option", "target": "Truck model", "option": "1"},
    {"do": "select_option", "target": "Trailer type", "option": "Semitrailer"},
    {"do": "select_option", "target": "Trailer make", "option": "2"},
    {"do": "set_checked", "target": "Licence verified", "checked": true},
    {"do": "set_checked", "target": "Vehicle suitable", "checked": true},
    {"do": "set_checked", "target": "Scope confirmed", "checked": true},
    {"do": "set_checked", "target": "Instrument reviewed", "checked": true},
    {"do": "click", "target": "Insert parameter", "tab_hint": "1 Prepare", "expect": {"dialog": "Insert parameter"}},
    {"do": "click", "target": "OK", "expect": {"message": "Name the parameter"}},
    {"do": "click", "target": "OK"},
    {"do": "click", "target": "Insert parameter", "tab_hint": "1 Prepare"},
    {"do": "type_text", "target": "Parameter name", "text": "Odometer start", "submit": "enter"},
    {"do": "type_text", "target": "Odometer start", "text": "123456"},
    {"do": "click", "target": "Insert parameter", "tab_hint": "1 Prepare"},
    {"do": "type_text", "target": "Parameter name", "text": "Odometer start", "submit": "enter",
     "expect": {"message": "already exists"}},
    {"do": "click", "target": "OK"},
    {"do": "click", "target": "Save preparation", "expect": {"status": "Saved locally"}},
    {"do": "expect", "contains": ["Synthetic haulage pty ltd", "Alex assessor", "Jordan example", "FLEET-42"]},
    {"do": "click", "target": "Save driver to directory", "expect": {"status": "Directory entry saved"}},
    {"do": "click", "target": "Save vehicle to directory", "expect": {"status": "Directory entry saved"}},
    {"do": "click", "target": "Save driver to directory", "expect": {"dialog": "Update directory entry"}},
    {"do": "click", "target": "Cancel"},
    {"do": "click", "target": "New from directory", "expect": {"dialog": "New assessment"}},
    {"do": "select_option", "target": "Choose driver snapshot:", "option": "Jordan example"},
    {"do": "click", "target": "OK", "expect": {"dialog": "New assessment"}},
    {"do": "select_option", "target": "Choose vehicle snapshot:", "option": "FLEET-42"},
    {"do": "click", "target": "OK", "expect": {"modal": false}},
    {"do": "expect", "contains": ["Jordan example", "FLEET-42"]},
    {"do": "screenshot", "note": "prepare filled"},
    {"do": "audit", "kind": "all"}
  ]
}
