{
  "name": "06-evidence",
  "title": "Evidence: policy gate, importing valid and broken files, file checks, trainer review and review copies",
  "features": ["evidence-policy-gate", "evidence-import", "media-check", "trainer-review", "review-copy",
               "duplicate-import", "file-chooser"],
  "app": {"seed": "sample"},
  "steps": [
    {"do": "select_item", "item": "New driver"},
    {"do": "select_tab", "tab": "3 Evidence"},
    {"do": "click", "target": "Import original evidence", "expect": {"status": "recording policy"}},
    {"do": "select_item", "item": "Riley Ready"},
    {"do": "select_tab", "tab": "3 Evidence"},
    {"do": "click", "target": "Import original evidence", "expect": {"dialog": "file chooser"}},
    {"do": "type_text", "target": "Path", "text": "drive-clip-12s-640x360.mp4", "submit": "enter"},
    {"do": "wait", "seconds": 20, "until": "idle"},
    {"do": "expect", "contains": "file check needed"},
    {"do": "click", "target": "Check video file", "expect": {"message": "Select an imported file first"}},
    {"do": "click", "target": "OK"},
    {"do": "select_item", "item": "original", "tab_hint": "3 Evidence"},
    {"do": "click", "target": "Check video file", "expect": {"status": "Media validated"}},
    {"do": "select_item", "item": "original", "tab_hint": "3 Evidence"},
    {"do": "click", "target": "Mark as reviewed", "expect": {"dialog": "Confirm trainer review"}},
    {"do": "click", "target": "Yes"},
    {"do": "expect", "contains": "Reviewed by trainer"},
    {"do": "select_item", "item": "original", "tab_hint": "3 Evidence"},
    {"do": "select_option", "target": "Review copy quality", "option": "review-480p"},
    {"do": "click", "target": "Create compressed review copy", "wait_busy": 60},
    {"do": "wait", "seconds": 60, "until": "idle"},
    {"do": "expect", "contains": "proxy"},
    {"do": "click", "target": "Import original evidence"},
    {"do": "type_text", "target": "Path", "text": "drive-clip-12s-640x360.mp4", "submit": "enter"},
    {"do": "wait", "seconds": 20, "until": "idle", "expect": {"status": "Import failed"}},
    {"do": "click", "target": "Import original evidence"},
    {"do": "type_text", "target": "Path", "text": "random-bytes.mp4", "submit": "enter"},
    {"do": "wait", "seconds": 20, "until": "idle"},
    {"do": "select_item", "item": "204,800 bytes", "tab_hint": "3 Evidence"},
    {"do": "click", "target": "Check video file", "wait_busy": 30, "expect": {"no_message": "Media validated"}},
    {"do": "click", "target": "Import original evidence"},
    {"do": "type_text", "target": "Path", "text": "empty.mp4", "submit": "enter"},
    {"do": "wait", "seconds": 20, "until": "idle"},
    {"do": "click", "target": "Import original evidence"},
    {"do": "type_text", "target": "Path", "text": "unicode ünïcødé 🚚 clip.mp4", "submit": "enter"},
    {"do": "wait", "seconds": 20, "until": "idle"},
    {"do": "click", "target": "Import original evidence"},
    {"do": "type_text", "target": "Path", "text": "../../outside.mp4", "submit": "enter", "expect": {"contains": "outside the QA sandbox"}},
    {"do": "click", "target": "Cancel", "window": "file chooser"},
    {"do": "screenshot", "note": "evidence list"},
    {"do": "audit", "kind": "all"}
  ]
}
