{
  "name": "11-business-directory",
  "title": "Business directory: assessor gate, companies, divisions, moving drivers and briefs",
  "features": ["business-directory", "directory-assessor-gate", "company", "division", "move-driver", "company-brief"],
  "app": {"seed": "sample"},
  "steps": [
    {"do": "select_item", "item": "New driver"},
    {"do": "click", "target": "Business directory", "expect": {"dialog": "Business directory"}},
    {"do": "click", "target": "New company", "expect": {"dialog": "New company"}},
    {"do": "type_text", "target": "Transport company name:", "text": "Acme Freight", "submit": "enter",
     "expect": {"message": "assessor name"}},
    {"do": "click", "target": "OK"},
    {"do": "click", "target": "Close", "window": "Business directory"},
    {"do": "select_item", "item": "Sam Synthetic"},
    {"do": "click", "target": "Business directory"},
    {"do": "click", "target": "New division", "expect": {"message": "Select a company"}},
    {"do": "click", "target": "OK"},
    {"do": "click", "target": "New company"},
    {"do": "type_text", "target": "Transport company name:", "text": "Acme Freight", "submit": "enter",
     "expect": {"contains": "Acme Freight"}},
    {"do": "select_item", "item": "Acme Freight"},
    {"do": "click", "target": "New division"},
    {"do": "type_text", "target": "Division folder in Acme Freight:", "text": "North", "submit": "enter"},
    {"do": "select_item", "item": "Acme Freight"},
    {"do": "click", "target": "New division"},
    {"do": "type_text", "target": "Division folder in Acme Freight:", "text": "North", "submit": "enter",
     "expect": {"message": "already exists"}},
    {"do": "click", "target": "OK"},
    {"do": "select_item", "item": "Dana Directory"},
    {"do": "click", "target": "Move driver to folder", "expect": {"dialog": "Move driver to folder"}},
    {"do": "select_option", "target": "Destination folder:", "option": "Acme Freight / North"},
    {"do": "click", "target": "OK", "window": "Move driver to folder"},
    {"do": "select_item", "item": "Acme Freight"},
    {"do": "type_text", "target": "Company brief", "text": "Linehaul contractor. Night shifts."},
    {"do": "click", "target": "Save brief"},
    {"do": "click", "target": "Close", "window": "Business directory"},
    {"do": "click", "target": "Business directory"},
    {"do": "select_item", "item": "Acme Freight"},
    {"do": "expect", "value": {"target": "Company brief", "contains": "Linehaul contractor"}},
    {"do": "expect", "value": {"target": "Company / division / driver record", "contains": "Dana Directory"}},
    {"do": "screenshot", "note": "business directory"},
    {"do": "click", "target": "Close", "window": "Business directory"}
  ]
}
